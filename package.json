{
  "name": "samsung-reminder-desktop",
  "version": "0.1.3",
  "description": "Unofficial Samsung Reminder desktop client and local MCP server",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/eliasblume/samsung-reminder-desktop.git"
  },
  "homepage": "https://github.com/eliasblume/samsung-reminder-desktop#readme",
  "bugs": {
    "url": "https://github.com/eliasblume/samsung-reminder-desktop/issues"
  },
  "private": true,
  "packageManager": "pnpm@11.17.0",
  "engines": {
    "node": ">=22.12.0"
  },
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "typecheck": "tsc --noEmit",
    "tauri": "tauri",
    "tauri:dev": "tauri dev",
    "tauri:build": "tauri build -- --locked",
    "build:mcp": "cargo build --locked --manifest-path src-tauri/Cargo.toml --bin samsung-reminder-mcp --release"
  },
  "dependencies": {
    "@radix-ui/react-alert-dialog": "1.1.23",
    "@radix-ui/react-dialog": "1.1.23",
    "@radix-ui/react-dropdown-menu": "2.1.24",
    "@radix-ui/react-popover": "1.1.23",
    "@radix-ui/react-scroll-area": "1.2.18",
    "@radix-ui/react-separator": "1.1.15",
    "@radix-ui/react-switch": "1.3.7",
    "@radix-ui/react-tooltip": "1.2.16",
    "@tanstack/query-db-collection": "1.2.1",
    "@tanstack/react-db": "0.1.95",
    "@tanstack/react-query": "5.101.4",
    "@tauri-apps/api": "2.11.1",
    "lucide-react": "1.28.0",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@tailwindcss/vite": "4.3.3",
    "@tauri-apps/cli": "2.11.4",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.4",
    "@vitejs/plugin-react": "6.0.5",
    "tailwindcss": "4.3.3",
    "typescript": "7.0.2",
    "vite": "8.2.1"
  }
}
